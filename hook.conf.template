# email address where alerts are sent on failures
OWNER_EMAIL=owner@domain.tld

# sender address
FROM_EMAIL=postmaster@domain.tld

# Command used to reload the web server after certificate deployment
# Examples:
# RELOAD_WEBSERVER_CMD="systemctl reload httpd"
# RELOAD_WEBSERVER_CMD="apachectl graceful"
# RELOAD_WEBSERVER_CMD="nginx -s reload"
RELOAD_WEBSERVER_CMD="systemctl reload httpd"

# The message template which will be used to draft the email alert
MSG_TEMPLATE="$(dirname $0)/hook.tpl"

# domains.txt path
DOMAINS_TXT=/etc/dehydrated/domains.txt
# certificates' dir
CERTSDIR=/etc/dehydrated/certs


# ---- Mail server settings ---------------------------------------------
#
# Put MAKE_MAIL_CERTS=0 if this is not a mail server and
# ignore what follows
# -----------------------------------------------------------------------

# Build certs for qmail. Put 1 only in case this is a qmail server.
MAKE_MAIL_CERTS=1

# Put 1 to enable cert creation for SNI (Server Name Indication).
# SNI is a TLS extension which allows clients to indicate the hostname
# to connect to before the connection gets encrypted.
ENABLE_SNI=0

# dovecot config file generated from domains.txt.
# Do not edit manually.
# Ignored if ENABLE_SNI=0
DOVECOT_SNI_CONF=/usr/local/dovecot/etc/dovecot/sni.conf

# Put 1 to add entries to the $APACHE_SNI_DOMAINS file
ENABLE_APACHE_SNI_CONF=0

# qmail dir
QMAILDIR=/var/qmail
# qmailctl command
QMAILCTL=${QMAILDIR}/bin/qmailctl
# doveadm command
DOVEADM=/usr/local/dovecot/bin/doveadm

# apache config file where to save ServerAlias entries for SNI like
# ServerAlias smtp.example.tld imap.example.tld pop3.example.tld
# Do not edit manually
# Ignored if ENABLE_SNI=0 or ENABLE_APACHE_SNI_CONF=0
APACHE_SNI_CONF=/etc/httpd/sni.conf

# Get vpopmail directory. Ignored if ENABLE_SNI=0
VPOPMAILDIR=/home/vpopmail

# Put here the user and group who owns the qmail certificates.
# It has to be the user who runs qmail-smtpd.
CERT_UID=vpopmail
CERT_GID=vchkpw
